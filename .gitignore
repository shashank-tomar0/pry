node_modules/
dist/
*.log

# Large model binaries (download via: node scripts/fetch-models.mjs)
models/ner/onnx/
models/guard/

# Large build artifacts.
# Extension zips are NOT committed: the full build is ~125 MB, which is over
# GitHub's 100 MB per-file limit, and a committed copy silently goes stale
# (the landing page spent weeks serving a 26-entry zip with no models in it).
# `npm run package` writes publish/pry-agent-1.0.0.zip; upload it as a GitHub
# Release asset and let the landing button link to the release URL.
landing/*.zip
publish/*.zip
/pry-agent-1.0.0.zip
.DS_Store
.rocketride/

# Test artifacts
scripts/.verify-out.mjs
scripts/.tripwire-iife.js
# Bundled for bench:latency (the bench needs the shipped tile planner, and Node
# cannot import the TypeScript source directly).
scripts/.face-regions.mjs
eng.traineddata
.ocr-cache/

# Local working files (never publish)
%TEMP%*
.freebuff/
pry-live.html
pry-io.html
verify-landing.html
.agents/
.claude/
skills-lock.json
